<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No runtime permissions are requested.
      QR images come from Android's own photo picker, which grants access to the
      files the user selects. The app never asks for broad storage access, never
      scans the device, and never reads the gallery on its own.

      This app never automates banking screens, PIN entry, OTP or biometrics.
    -->

    <!--
      Package visibility (Android 11+): the app must be able to ask whether a
      banking app can receive the image it is about to hand over. Without this
      the platform hides other apps and the check would report "not found" even
      when the bank is installed. This grants no permissions and exposes no data.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
        <!--
          The verified financial apps from BankRegistry (Google Play package ids
          checked on 2026-09-19). Listed individually on purpose: the app only
          needs to see the specific apps it can hand a QR image to, not all
          installed packages.
        -->
        <package android:name="com.kasikorn.retail.mbanking.wap" />
        <package android:name="com.scb.phone" />
        <package android:name="ktbcs.netbank" />
        <package android:name="com.bbl.mobilebanking" />
        <package android:name="com.krungsri.kma" />
        <package android:name="com.TMBTOUCH.PRODUCTION" />
        <package android:name="com.mobilife.gsb.mymo" />
        <package android:name="com.cimbthai.digital.mycimb" />
        <package android:name="com.uob.mightyth2" />
        <package android:name="com.dimekkp.dimeapp" />
        <package android:name="com.kasikornbank.makebykbank" />
        <package android:name="com.krungsri.kept" />
        <package android:name="th.co.truemoney.wallet" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QrQueue">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QrQueue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Shares only the app-private queue image copies with the selected bank.
          Exported=false plus grantUriPermissions means no other app can read
          them without an explicit, per-use grant.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
